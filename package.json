{
  "name": "ground-truth-evals",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "An evaluation harness that scores LLM poker decisions against computed ground truth.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "cases": "node examples/poker/build-cases.mjs",
    "eval": "node bin/eval.mjs",
    "eval:stub": "node bin/eval.mjs --model stub",
    "results": "node bin/compare.mjs --title \"Measurements: ground-truth-evals\"",
    "cases:dates": "node examples/dates/build-cases.mjs",
    "eval:dates": "node bin/eval.mjs --suite examples/dates/suite.js --model stub"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yangstar89/ground-truth-evals.git"
  }
}
